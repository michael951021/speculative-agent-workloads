# syntax=docker/dockerfile:1
# speculative-agent-workloads gateway: static Go binary on distroless, non-root.
# Build (context = repo root):
#   docker build -f deploy/docker/Dockerfile.gateway -t speculative-agent-workloads/gateway .
# The chart mounts its own config at /app/config.yaml; the baked one is a
# dev default (engine on 127.0.0.1:8100).
FROM golang:1.26.8-alpine AS build
WORKDIR /src
COPY gateway/go.mod gateway/go.sum ./
RUN go mod download
COPY gateway/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/gateway .

FROM gcr.io/distroless/static-debian12:nonroot
# base already runs as nonroot (uid 65532); restated explicitly
USER 65532:65532
WORKDIR /app
COPY --from=build /out/gateway /app/gateway
COPY gateway/config.yaml /app/config.yaml
EXPOSE 8200
ENTRYPOINT ["/app/gateway"]
CMD ["-config", "/app/config.yaml"]
